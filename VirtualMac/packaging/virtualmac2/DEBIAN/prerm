#!/bin/sh
set -eu
export PATH=/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin:/usr/sbin:/sbin
processes=$(ps -A -o command=)
if printf '%s\n' "$processes" | awk '
    /\/VirtualMac2\/payload\/VirtualMachine\.xpc\/Contents\/MacOS\/com\.apple\.Virtualization\.VirtualMachine([[:space:]]|$)/ ||
    /\/VirtualMac2\/payload\/Installation\.xpc\/Contents\/MacOS\/com\.apple\.Virtualization\.Installation([[:space:]]|$)/ ||
    /\/VirtualMac2\/payload\/.*\/com\.apple\.gpusw\.ParavirtualizedGraphicsGPUTask([[:space:]]|$)/ ||
    /\/VirtualMac2\/compiler27\/metal-library-convert([[:space:]]|$)/ ||
    /\/VirtualMac2\.app\/VirtualMac([[:space:]]|$)/ { found=1 }
    END { exit !found }'; then
    echo "Shut down the Virtual Mac 2 guest normally and close the app first." >&2
    exit 1
fi
case "${1:-}" in
    remove|deconfigure) uicache -u /var/jb/Applications/VirtualMac2.app ;;
esac
exit 0
