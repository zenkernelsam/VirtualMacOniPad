+def decodeV5Pointer(raw: int, valueAdd: int):
+	"""Return (target, auth, key, diversity, addrDiv, byteDelta).
+
+	Layout: Apple's dyld_cache_format.h and fixup-chains.h, shared-cache
+	arm64e rebase. keyIsData maps to the USERLAND IA=0 / DA=2 key values.
+	"""
+	target = valueAdd + (raw & ((1 << 34) - 1))
+	auth = (raw >> 63) & 1
+	delta = ((raw >> 52) & 0x7ff) * 8
+	if auth:
+		return (target, 1, ((raw >> 51) & 1) * 2,
+		        (raw >> 34) & 0xffff, (raw >> 50) & 1, delta)
+	return (target | (((raw >> 34) & 0xff) << 56), 0, 0, 0, 0, delta)
+
+
+class _V5Rebaser(_V3Rebaser):
+	def _rebasePage(self, ctx, pageOffset: int, delta: int) -> None:
+		loc = pageOffset + delta
+		end = pageOffset + self.slideInfo.page_size
+		while True:
+			if loc < pageOffset or loc + 8 > end or (loc - pageOffset) % 8:
+				raise ValueError("Invalid slide-info-v5 page chain")
+			raw = self.dyldCtx.readFormat("<Q", loc)[0]
+			target, _, _, _, _, delta = decodeV5Pointer(raw, self.slideInfo.value_add)
+			ctx.writeBytes(loc, struct.pack("<Q", target))
+			if delta == 0:
+				break
+			loc += delta
+
