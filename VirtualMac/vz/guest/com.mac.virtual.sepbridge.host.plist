<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mac.virtual.sepbridge.host</string>
    <key>ProgramArguments</key>
    <array><string>/var/jb/sepbridge/sepbridge-helper</string></array>
    <!-- user/501 bootstrap; the fixed-protocol helper elevates via its own
         root-owned 4755 bit. UserName=root is rejected in some user domains. -->
    <key>RunAtLoad</key><false/>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>30</integer>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>/var/jb/sepbridge/helper.log</string>
    <key>StandardErrorPath</key><string>/var/jb/sepbridge/helper.err</string>
</dict>
</plist>
