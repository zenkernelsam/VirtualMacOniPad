@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT @BUILD_SHARED_LIBS@)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(MbedTLS 2.28)
endif()
if(@APPLE_AUTH_WITH_CLIENT@ AND NOT @BUILD_SHARED_LIBS@)
    if(@APPLE_AUTH_WITH_CURL@)
        find_dependency(CURL 7.85)
    endif()
    find_dependency(nlohmann_json 3.10)
    if(WIN32)
        find_dependency(unofficial-libplist CONFIG)
    elseif(NOT APPLE)
        find_dependency(PkgConfig)
        pkg_check_modules(PLIST REQUIRED IMPORTED_TARGET libplist-2.0>=2.3)
    endif()
endif()
if(@APPLE_AUTH_WITH_TESTFLIGHT@ AND NOT @BUILD_SHARED_LIBS@)
    find_dependency(ZLIB)
    if(WIN32)
        find_dependency(libzip CONFIG)
    else()
        find_dependency(PkgConfig)
        pkg_check_modules(TF_ZIP REQUIRED IMPORTED_TARGET libzip)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/apple_authTargets.cmake")
set(apple_auth_core_FOUND TRUE)
set(apple_auth_client_FOUND FALSE)
if(TARGET apple_auth::client)
    set(apple_auth_client_FOUND TRUE)
endif()
check_required_components(apple_auth)
