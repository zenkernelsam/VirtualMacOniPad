#!/bin/sh
set -eu
export PATH=/var/jb/usr/bin:/var/jb/usr/sbin:/var/jb/bin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin

test -d /var/jb/Applications || { echo "Virtual Mac 2 requires a rootless jailbreak." >&2; exit 1; }
test -x /var/jb/usr/bin/jbctl || test -x /var/jb/basebin/jbctl || {
    echo "Virtual Mac 2 requires the rootless jailbreak trustcache tool." >&2
    exit 1
}
for parent in /var/root/VirtualMac2 /var/root/VirtualMac2/payload \
    /var/root/VirtualMac2/package-source /var/root/VirtualMac2/package-source/compiler27 \
    /var/root/VirtualMac2/compiler27 /var/root/VirtualMac2/compiler27/work \
    /var/root/VirtualMac2/testing /var/root/VirtualMac2/release \
    /var/root/VirtualMac2/shader-cache /var/root/VirtualMac2/shader-cache/air25 \
    /var/jb/Applications/VirtualMac2.app; do
    test ! -L "$parent" || { echo "Refusing a symlinked private runtime directory: $parent" >&2; exit 1; }
done
processes=$(ps -A -o command=)
if printf '%s\n' "$processes" | awk '
    /\/Contents\/MacOS\/com\.apple\.Virtualization\.VirtualMachine([[:space:]]|$)/ ||
    /\/Contents\/MacOS\/com\.apple\.Virtualization\.Installation([[:space:]]|$)/ ||
    /\/Contents\/MacOS\/com\.apple\.gpusw\.ParavirtualizedGraphicsGPUTask([[:space:]]|$)/ ||
    /\/VirtualMac2\/compiler27\/metal-library-convert([[:space:]]|$)/ ||
    /\/VirtualMac2\.app\/VirtualMac([[:space:]]|$)/ { found=1 }
    END { exit !found }'; then
    echo "Shut down virtual machines normally and close Virtual Mac 2 before installing." >&2
    exit 1
fi
# This script intentionally does not terminate a VM, change the normal app,
# restart shared network daemons, or modify files in /System or /usr.
exit 0
