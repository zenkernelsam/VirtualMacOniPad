+	def _originalBaseList(self, address: int) -> int:
+		if not (address & 1):
+			return address
+		listAddress = address & ~1
+		offset, context = self._dyldCtx.convertAddr(listAddress)
+		entrySize, count = context.readFormat("<II", offset)
+		if entrySize != 8 or not 0 < count <= 65536:
+			raise _ObjCFixerError("Invalid relative list-of-lists header")
+		entryAddress = listAddress + 8 + (count - 1) * 8
+		offset, context = self._dyldCtx.convertAddr(entryAddress)
+		# Low 16 bits are an image index; high 48 bits a signed byte offset.
+		relative = context.readFormat("<q", offset)[0] >> 16
+		return entryAddress + relative
+
 	def _processProtocolList(self, protoListAddr: int) -> int:
+		protoListAddr = self._originalBaseList(protoListAddr)
 		if protoListAddr in self._protocolListCache:
 			return self._protocolListCache[protoListAddr]
 
